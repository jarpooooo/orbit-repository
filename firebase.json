{
  "firestore": {
    "database": "(default)",
    "location": "asia-southeast2",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/katalog/:slug/jadwal",
        "destination": "/catalog/:slug/schedule",
        "type": 301
      },
      {
        "source": "/katalog/:slug/ajukan",
        "destination": "/catalog/:slug/request",
        "type": 301
      },
      {
        "source": "/katalog/:slug/surat",
        "destination": "/catalog/:slug/letter",
        "type": 301
      },
      {
        "source": "/katalog/:slug/ringkasan",
        "destination": "/catalog/:slug/summary",
        "type": 301
      },
      {
        "source": "/katalog/:path*",
        "destination": "/catalog/:path",
        "type": 301
      },
      {
        "source": "/katalog",
        "destination": "/catalog",
        "type": 301
      },
      {
        "source": "/jadwal-ruang/paling-sering-dipinjam",
        "destination": "/room-schedule/most-borrowed",
        "type": 301
      },
      {
        "source": "/jadwal-ruang",
        "destination": "/room-schedule",
        "type": 301
      },
      {
        "source": "/pengajuan-saya",
        "destination": "/my-requests",
        "type": 301
      },
      {
        "source": "/cara-pinjam",
        "destination": "/how-to-borrow",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(svg|png|webp|ico|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/manifest+json"
          }
        ]
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5050
    },
    "ui": {
      "enabled": true
    },
    "singleProjectMode": true
  }
}
